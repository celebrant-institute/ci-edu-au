---
import { Code } from "astro/components";
const securityFeatures = [
{
 title: "Expert mentorship",
 description: "Benefit from direct access to Sarah and Josh, with unlimited questions answered through our Ask platform.",
},
{
 title: "Monthly newsletter",
 description: "Rest assured you'll stay updated with the latest celebrancy news, legal changes, and industry best practices.",
},
{
 title: "The Celebrant Talk Show",
 description: "Access our long-running podcast covering all aspects of celebrancy from legal requirements to business growth.",
},
{
 title: "Comprehensive blog",
 description: "Tap into hundreds of articles written specifically to help celebrants excel in ceremony creation and business.",
}
];
---

<section>
  <div
    class="max-w-7xl px-8 md:px-12 lg:px-32 mx-auto py-12 lg:py-32 space-y-24"
  >
    <div>
      <p class="text-3xl font-normal tracking-tight text-black font-display">
        Empowering Australian celebrants with
        <span class="md:block text-accent-500">
          full control over their celebrancy journey.
        </span>
      </p>
      <p class="text-base mt-4 text-zinc-500 max-w-2xl">
        Transform ordinary ceremonies into extraordinary experiences effortlessly. Witness the magic unfold as your skills evolve into creating captivating and unforgettable weddings that couples will cherish forever.
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a
          title="link to members page"
          aria-label="Membership"
          href="https://members.celebrant.institute"
          class="rounded-lg px-4 py-2 text-sm font-semibold transition-all flex items-center justify-center text-white bg-gradient-to-b from-accent-500 to-accent-600 hover:to-accent-700 h-10"
          >Become a member</a
        >
        <a
          title="Read the blog"
          aria-label="Read the blog"
          href="https://celebrant.institute"
          class="rounded-lg px-4 border py-2 text-sm font-semibold transition-all flex items-center justify-center bg-white text-zinc-500 hover:text-accent-500 h-10 border-zinc-300"
          >Read the blog</a
        >
        <a
          title="Listen to the podcast"
          aria-label="Listen to the podcast"
          href="https://celebrant.fm"
          class="rounded-lg px-4 border py-2 text-sm font-semibold transition-all flex items-center justify-center bg-white text-zinc-500 hover:text-accent-500 h-10 border-zinc-300"
          >Listen to the podcast</a
        >
        <a
          title="Subscribe to the monthly mailout"
          aria-label="Subscribe to the monthly mailout"
          href="https://mail.celebrant.institute"
          class="rounded-lg px-4 border py-2 text-sm font-semibold transition-all flex items-center justify-center bg-white text-zinc-500 hover:text-accent-500 h-10 border-zinc-300"
          >Subscribe to the monthly mailout</a
        >
      </div>
    </div>
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 gap-y-8 list-none"
      role="list"
    >
      {
        securityFeatures.map((feature) => (
          <li>
            <p class="font-display text-xl leading-7 tracking-tight text-black">
              {feature.title}
            </p>
            <p class="text-sm text-zinc-500 mt-4">{feature.description}</p>
          </li>
        ))
      }
    </ul>
    <div
      class="grid grid-cols-1 gap-4 mt-6 items-center lg:grid-cols-2 lg:gap-12"
    >
      
  </div>
</section>
