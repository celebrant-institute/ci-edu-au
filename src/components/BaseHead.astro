---
import "../styles/global.css";
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="Celebrant Institute RTO"
  description="As Australia's leading celebrant training provider, the Celebrant Institute RTO delivers the Certificate IV in Celebrancy qualification you need to become an authorised marriage celebrant. Learn from industry expert Sarah Aird to create meaningful ceremonies that couples will cherish forever."
  canonical="https://celebrantinstitute.edu.au/"
  openGraph={{
    url: "https://celebrantinstitute.edu.au/",
    title: "Celebrant Institute RTO",
    description: "As Australia's leading celebrant training provider, the Celebrant Institute RTO delivers the Certificate IV in Celebrancy qualification you need to become an authorised marriage celebrant. Learn from industry expert Sarah Aird to create meaningful ceremonies that couples will cherish forever.",
    images: [
      {
        url: "https://celebrantinstitute.edu.au/ogimage.png",
        width: 1200,
        height: 630,
        alt: "Celebrant Institute RTO",
        type: "image/jpeg",
      },
    ],
    site_name: "Celebrant Institute RTO",
    type: "website",
    locale: "en_AU",
  }}
/>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>Celebrant Institue RTO</title>
<meta
  name="description"
  content="As Australia's leading celebrant training provider, the Celebrant Institute RTO delivers the Certificate IV in Celebrancy qualification you need to become an authorised marriage celebrant. Learn from industry expert Sarah Aird to create meaningful ceremonies that couples will cherish forever."
/>
<meta name="keywords" content="celebrant, training, certificate IV in celebrancy, cert iv celebrancy, celebrancy, how to become a celebrant, celebrant training, online" />
<meta name="author" content="Celebrant Institue RTO" />

<!-- Favicons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Celebrant Institute" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

<!-- Favicons for different sizes -->
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://celebrantinstitute.edu.au/" />
<meta property="og:title" content="Celebrant Institute RTO" />
<meta
  property="og:description"
  content="As Australia's leading celebrant training provider, the Celebrant Institute RTO delivers the Certificate IV in Celebrancy qualification you need to become an authorised marriage celebrant. Learn from industry experts Sarah Aird to create meaningful ceremonies that couples will cherish forever."
/>
<meta
  property="og:image"
  content="https://celebrantinstitute.edu.au/ogimage.png"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://celebrantinstitute.edu.au/" />
<meta property="twitter:title" content="Celebrant Institute RTO" />
<meta
  property="twitter:description"
  content="As Australia's leading celebrant training provider, the Celebrant Institute RTO delivers the Certificate IV in Celebrancy qualification you need to become an authorised marriage celebrant. Learn from industry expert Sarah Aird to create meaningful ceremonies that couples will cherish forever."
/>
<meta
  property="twitter:image"
  content="https://celebrantinstitute.edu.au/ogimage.png"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://celebrantinstitute.edu.au/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#ffffff" />

<!-- For IE -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<!-- Inter Font: https://rsms.me/inter/ -->
<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
  rel="stylesheet"
/>
